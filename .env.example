# Darlink local deployment configuration
# Copy this file to .env.local and fill real private values locally.
# Do not commit .env.local.

# Runtime
DARLINK_ALLOWED_EMAIL_DOMAINS=connect.hku.hk,link.cuhk.edu.hk,connect.ust.hk
DARLINK_AUTH_MODE=test
DARLINK_DEV_EMAIL_CODES=false

# SMTP real email verification
# Common ports:
# - 587 with SMTP_SECURITY=starttls
# - 465 with SMTP_SECURITY=ssl
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM=Darlink <no-reply@example.com>

# Doubao / Volcengine Ark
ARK_API_KEY=your-volcengine-ark-api-key
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_MODEL=doubao-seed-evolving
DOUBAO_API_KEY=

# Ark-hosted DeepSeek fallback
ARK_DEEPSEEK_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
ARK_DEEPSEEK_MODEL=deepseek-v4-pro-260425
ARK_DEEPSEEK_API_KEY=

# DeepSeek
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=your-deepseek-api-key

# OpenAI-compatible fallback
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key

# AI request tuning
AI_REQUEST_TIMEOUT=45
AI_PROFILE_OVERALL_TIMEOUT=45
AI_PROFILE_MAX_TOKENS=900
AI_PROFILE_TEMPERATURE=0.62
AI_CHAT_TIMEOUT=35
AI_CHAT_OVERALL_TIMEOUT=35
AI_CHAT_MAX_TOKENS=220
AI_CHAT_TEMPERATURE=0.68
